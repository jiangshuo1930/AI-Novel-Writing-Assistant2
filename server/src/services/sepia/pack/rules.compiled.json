    "techniques": [
      {
        "id": "tech1",
        "no": 1,
        "name": "糙话/脏话",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "真人会骂。适当塞口语化的糙话、不耐烦。"
      },
      {
        "id": "tech2",
        "no": 2,
        "name": "走神闲笔",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "真人干活会走神，会想无关的事。"
      },
      {
        "id": "tech3",
        "no": 3,
        "name": "迟钝与记错",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "真人反应慢、记混、事后才懂。"
      },
      {
        "id": "tech4",
        "no": 4,
        "name": "碎对话",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "真人说话会断、答非所问、半句就停。"
      },
      {
        "id": "tech5",
        "no": 5,
        "name": "长短混排",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "别一句一行。长的拖，短的戳。一句独立成段只用在情绪高点。"
      },
      {
        "id": "tech6",
        "no": 6,
        "name": "不完美角色",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "主角会怂、会贪、会嘴硬、会做蠢事。别写成完美的推理机。"
      },
      {
        "id": "tech7",
        "no": 7,
        "name": "生活化脏细节",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "尿憋、呼噜、饿、脚臭、想体面又顾不上。"
      },
      {
        "id": "tech8",
        "no": 8,
        "name": "具体而不解释",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "只写发生了什么，不替读者总结含义，不分析动机。"
      },
      {
        "id": "tech9",
        "no": 9,
        "name": "故意打破",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "在叙述里故意加口语打断，破坏严谨，让文字有温度。"
      },
      {
        "id": "tech10",
        "no": 10,
        "name": "句式断裂",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "情绪高点或转折点，用极短句独立成段。"
      },
      {
        "id": "tech11",
        "no": 11,
        "name": "层层剥开",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "不直接讲结论。用\"现象→表面解释→更深追问→核心\"往下扒。"
      },
      {
        "id": "tech12",
        "no": 12,
        "name": "承认复杂",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "真人会矛盾、会拿不准。别写得太笃定。"
      },
      {
        "id": "tech13",
        "no": 13,
        "name": "白描优先，比喻克制",
        "tags": [
          "底层"
        ],
        "part": "base",
        "summary": "能用身体反应写的，别写\"像什么\"。但**比喻不必全清零**：自然嵌进来的感官小比喻（「像两颗泡在水里的黑豆」「手抖得像刚攥完一把冰」）是活人语感，可以留。"
      },
      {
        "id": "tech14",
        "no": 14,
        "name": "对话密度与角色嗓音",
        "tags": [
          "底层",
          "正向硬指标"
        ],
        "part": "base",
        "summary": "去 AI 不等于写白开水。网文靠对话推剧情、立人物，纯叙述堆场景会显淡。"
      },
      {
        "id": "tech15",
        "no": 15,
        "name": "私人细节（反通用模板）",
        "tags": [
          "必上",
          "换骨"
        ],
        "part": "core",
        "summary": "AI 写童年全是\"老相册、褪色照片、老房子\"。真人会有专属的零食、某条街的气味、某个只有自己记得的荒诞片段。"
      },
      {
        "id": "tech16",
        "no": 16,
        "name": "情绪行为化（反标签）",
        "tags": [
          "必上",
          "换骨"
        ],
        "part": "core",
        "summary": "AI 描述情绪靠贴标签。真人通过身体、动作、行为传递。读者自己感受到的，比告诉他有力得多。"
      },
      {
        "id": "tech17",
        "no": 17,
        "name": "人性灰度（反善恶二元）",
        "tags": [
          "必上",
          "换骨"
        ],
        "part": "core",
        "summary": "好人要有不光彩的瞬间，坏人也有不忍的时刻。"
      },
      {
        "id": "tech18",
        "no": 18,
        "name": "恐惧记忆锚定（反万能模板）",
        "tags": [
          "按类型",
          "悬疑恐怖"
        ],
        "part": "core",
        "summary": "AI 写恐惧只有当下反应。真人在恐惧时，脑子会不受控地翻出过去最怕的画面。越怕，闪回越具体、越私人。"
      },
      {
        "id": "tech19",
        "no": 19,
        "name": "干扰项（反零废料）",
        "tags": [
          "必上",
          "换骨"
        ],
        "part": "core",
        "summary": "AI 的线索会在结尾精准回收，一条不浪费。真人叙事一定有冗余、有误判、有说不清的东西。"
      },
      {
        "id": "tech20",
        "no": 20,
        "name": "句式跟情绪走（反工整罗列）",
        "tags": [
          "按情境"
        ],
        "part": "core",
        "summary": "AI 不管人物在什么情绪里，句子结构都一样工整。"
      },
      {
        "id": "tech21",
        "no": 21,
        "name": "感官偏见（反通用正确）",
        "tags": [
          "必上",
          "换骨"
        ],
        "part": "core",
        "summary": "AI 的感官永远准确，永远没有偏见。真人的感官带着个人历史：同一个味道，不同的人想起完全不同的东西。"
      },
      {
        "id": "tech22",
        "no": 22,
        "name": "主角必须犯错（反全知视角）",
        "tags": [
          "按类型",
          "悬疑探案"
        ],
        "part": "core",
        "summary": "AI 的主角推理全程正确，每条线索精准命中。真探案一定会走错、猜错、推翻自己。"
      },
      {
        "id": "tech23",
        "no": 23,
        "name": "超自然规则私人化（反空降）",
        "tags": [
          "按类型",
          "玄幻修仙"
        ],
        "part": "core",
        "summary": "AI 写超自然只给结果，从不解释\"为什么是这个规则\"\"为什么是现在\"\"为什么是这个人\"。"
      },
      {
        "id": "tech24",
        "no": 24,
        "name": "信息碎玻璃（反直塞）",
        "tags": [
          "必上",
          "换骨"
        ],
        "part": "core",
        "summary": "AI 只会让关键信息通过口述、文档、截图、搜索一次性交代。真人的伏笔是碎玻璃：真相打碎成 5–7 片，散在日常里。"
      },
      {
        "id": "tech25",
        "no": 25,
        "name": "数字体感化（反量化恐怖）",
        "tags": [
          "按类型",
          "悬疑"
        ],
        "part": "core",
        "summary": "用精确数字制造诡异感（多少秒、多少公分）是机器的习惯。数字越准，假得越明显。"
      },
      {
        "id": "tech26",
        "no": 26,
        "name": "道具非功能化（反 100% 功能化）",
        "tags": [
          "必上",
          "换骨"
        ],
        "part": "core",
        "summary": "AI 写的每件道具都精准服务一条线索。真人小说里全是没用的东西。"
      },
      {
        "id": "tech27",
        "no": 27,
        "name": "电影化叙事",
        "tags": [
          "可选"
        ],
        "part": "core",
        "summary": "允许镜头感和画面冲击力。但不强行、不 OOC、不为桥段牺牲剧情。"
      },
      {
        "id": "tech28",
        "no": 28,
        "name": "适度玩梗",
        "tags": [
          "可选"
        ],
        "part": "core",
        "summary": "三条铁律：不 OOC、不强行、不破坏氛围。"
      },
      {
        "id": "tech29",
        "no": 29,
        "name": "画面感白描",
        "tags": [
          "可选"
        ],
        "part": "core",
        "summary": "白描不是干巴陈述，是用最少的字让人看见。"
      },
      {
        "id": "tech30",
        "no": 30,
        "name": "减空洞，加颗粒（贯穿全程）",
        "tags": [
          "必上",
          "辩证铁律"
        ],
        "part": "core",
        "summary": "减的是\"空\"（任何小说都能套的通用修辞），加的是\"实\"（只有这个人物、这个场景才有的颗粒）。两件事必须同时做。只减不加会干巴，只加不减会臃肿。"
      }
    ],
